{
  "name": "world-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node tests/run-all.js",
    "stress": "node tests/stability-1000-test.js",
    "demo": "node demo/run-demo.js",
    "templates": "node demo/template-demo.js",
    "play": "node demo/play-demo.js",
    "shell": "node demo/play-shell.js",
    "shell:sample": "node demo/play-shell.js --script demo/sample-commands.txt",
    "snapshot": "node demo/export-snapshot.js",
    "runtime": "node demo/runtime-demo.js",
    "performance:report": "node demo/performance-report-cli.js",
    "database:summary": "node demo/database-summary-cli.js",
    "database:check": "node demo/database-check-cli.js",
    "api": "node demo/api-server.js",
    "api:live": "node demo/api-server.js --auto-loop --interval 1000 --ticks-per-cycle 1 --autosave-every 25 --autosave-path output/live-world-save.json",
    "api:live:db": "node demo/api-server.js --auto-loop --interval 1000 --ticks-per-cycle 1 --autosave-every 25 --autosave-mode database --db-provider jsonl --db-dir world-engine/data/db --db-name world-engine --resume-mode if-present",
    "viewer": "node viewer/serve-viewer.js",
    "database:postgres": "node demo/database-postgres-cli.js",
    "database:backup": "node demo/database-backup-cli.js",
    "database:maintain": "node demo/database-maintenance-cli.js",
    "account:admin": "node demo/account-admin-cli.js",
    "test:postgres:account-admin": "node tests/integration/postgres-account-admin.js",
    "test:postgres:maintenance": "node tests/integration/postgres-maintenance.js",
    "test:postgres:backup": "node tests/integration/postgres-backup.js",
    "test:postgres": "node tests/integration/postgres-store.js",
    "test:postgres:commands": "node tests/integration/postgres-command-inbox.js",
    "runtime:postgres": "node demo/durable-runtime-cli.js",
    "test:postgres:runtime": "node tests/integration/postgres-durable-runtime.js",
    "test:postgres:runtime-commands": "node tests/integration/postgres-runtime-commands.js",
    "api:postgres:commands": "node demo/durable-command-api-server.js",
    "test:postgres:command-api": "node tests/integration/postgres-command-api.js",
    "test:postgres:command-audit": "node tests/integration/postgres-command-audit.js",
    "test:postgres:endurance": "node tests/integration/postgres-engine-endurance.js",
    "test:postgres:command-audit-query": "node tests/integration/postgres-command-audit-query.js"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
