# Connection URL is provided by your local environment/secret manager.
# Do not commit real credentials or pass them on a CLI argument.
WORLD_ENGINE_DATABASE_URL=postgresql://world_engine:REPLACE_LOCALLY@127.0.0.1:5432/world_engine
WORLD_ENGINE_DB_SCHEMA=world_engine
WORLD_ENGINE_DB_POOL_SIZE=4
# Local connections can use disable. Remote default is verify-full.
WORLD_ENGINE_DB_SSL_MODE=disable
# Optional PEM CA content for a remote verified TLS connection:
# WORLD_ENGINE_DB_SSL_CA=
